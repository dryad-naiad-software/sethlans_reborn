# ==============================================================
# Sethlans Docker Compose Environment Variables
# Copy this file to .env and fill in required values.
# ==============================================================

# ---- REQUIRED ----

# Django secret key (must be unique, random, and at least 50 chars).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SETHLANS_SECURITY_SECRET_KEY=

# ---- OPTIONAL (Manager) ----

# Seed an enrollment key into the manager DB on first boot
# SETHLANS_SECURITY_ENROLLMENT_KEY=

# Manager advertised name for multicast discovery
# SETHLANS_ENROLLMENT_NAME=Sethlans Manager

# Override advertised IP for multicast (needed if behind NAT/Docker)
# SETHLANS_ENROLLMENT_ADVERTISED_IP=

# BYO TLS certificate paths (inside the container)
# SETHLANS_TLS_CERT_FILE=/certs/cert.pem
# SETHLANS_TLS_KEY_FILE=/certs/key.pem

# ---- OPTIONAL (PostgreSQL overlay) ----

# Required only when using docker-compose.postgres.yml overlay
# SETHLANS_DB_PASSWORD=

# ---- OPTIONAL (Worker) ----

# Manager hostname/IP from the worker's perspective
# SETHLANS_MANAGER_HOST=manager
# SETHLANS_MANAGER_PORT=8080

# Enrollment key for unattended worker registration
# SETHLANS_WORKER_ENROLLMENT_KEY=

# ==============================================================
# VOLUME OWNERSHIP: All containers run as uid 1000. Pre-create
# bind-mount directories with correct ownership:
#   mkdir -p data/manager data/worker config/manager config/worker
#   sudo chown -R 1000:1000 data/ config/
# ==============================================================
