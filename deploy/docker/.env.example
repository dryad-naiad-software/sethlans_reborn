# ==============================================================
# Sethlans Docker Compose Environment Variables
# Copy this file to .env and fill in required values.
# ==============================================================

# ---- REQUIRED ----

# Django secret key (must be unique, random, and at least 50 chars).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SETHLANS_SECURITY_SECRET_KEY=

# ---- FIRST ADMIN (Manager, first start) ----

# The manager exits with code 12 if it has no admin account. On the
# first start it makes one from this username and the password in
# ./secrets/admin_password (the sethlans_admin_password secret, read
# through SETHLANS_ADMIN_PASSWORD_FILE). Put the password on one line in
# that file; never put it in this file. Ignored once an admin exists.
SETHLANS_ADMIN_USERNAME=
# SETHLANS_ADMIN_EMAIL=

# ---- OPTIONAL (Manager) ----

# Seed an enrollment key into the manager DB on first boot
# SETHLANS_SECURITY_ENROLLMENT_KEY=

# Manager advertised name for multicast discovery
# SETHLANS_ENROLLMENT_NAME=Sethlans Manager

# Override advertised IP for multicast (needed if behind NAT/Docker)
# SETHLANS_ENROLLMENT_ADVERTISED_IP=

# BYO TLS certificate paths (inside the container)
# SETHLANS_TLS_CERT_FILE=/certs/cert.pem
# SETHLANS_TLS_KEY_FILE=/certs/key.pem

# ---- OPTIONAL (PostgreSQL overlay) ----

# Required only when using docker-compose.postgres.yml overlay
# SETHLANS_DB_PASSWORD=

# ---- OPTIONAL (Worker) ----

# Manager hostname/IP from the worker's perspective
# SETHLANS_MANAGER_HOST=manager
# SETHLANS_MANAGER_PORT=8080

# Enrollment key for unattended worker registration
# SETHLANS_WORKER_ENROLLMENT_KEY=

# ---- OPTIONAL (GPU worker graphics cards) ----

# Used by docker-compose.gpu-nvidia.yml and docker-compose.gpu-rocm.yml.
# A GPU worker starts with no card ticked and renders on the CPU until
# its card choice is made, from the manager or the worker page, or here.
# Setting any of SETHLANS_COMPUTE_METHOD, SETHLANS_COMPUTE_GPU_MODE or
# SETHLANS_COMPUTE_CARDS fixes the whole card choice; the manager and the
# worker pages cannot change it. Leave all three unset to choose from the
# manager. An empty value (VAR=) counts as unset.

# Render method: cpu, gpu or cpu_gpu
# SETHLANS_COMPUTE_METHOD=gpu

# Comma-separated PCI addresses of the cards to use, as the worker logs
# them at start ("Graphics cards (operating system list ...)" lines).
# Find them with: docker compose logs worker | grep "pci:"
# SETHLANS_COMPUTE_CARDS=pci:0000:01:00.0,pci:0000:02:00.0

# With several cards: split (one job per card) or combined (all cards on one job)
# SETHLANS_COMPUTE_GPU_MODE=split

# Whether the manager may change the card choice: true or false. Only
# applies while the three settings above are unset; true cannot reopen
# a choice they fix.
# SETHLANS_COMPUTE_ALLOW_MANAGER_CHANGES=true

# ==============================================================
# VOLUME OWNERSHIP: All containers run as uid 1000. Pre-create
# bind-mount directories with correct ownership:
#   mkdir -p data/manager data/worker config/manager config/worker
#   sudo chown -R 1000:1000 data/ config/
# ==============================================================
