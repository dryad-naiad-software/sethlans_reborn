# NOTE: Requires deploy/docker/manager/Dockerfile.e2e.dockerignore to override
# the repo-root .dockerignore (which excludes tests/ from the build context).
#
# E2E test image based on Ubuntu 24.04 with Blender system dependencies.
# Blender requires OpenGL/EGL libraries and a virtual display (Xvfb) even in
# headless mode.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        curl \
        xz-utils \
        libegl1 \
        libgl1 \
        libglu1-mesa \
        libx11-6 \
        libxi6 \
        libxrender1 \
        libxkbcommon0 \
        libxxf86vm1 \
        libxfixes3 \
        libxcursor1 \
        libxinerama1 \
        libxrandr2 \
        libsm6 \
        libice6 \
        xvfb && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Create a virtual environment to avoid PEP 668 externally-managed restriction
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Install all Python deps (manager + worker + dev/test)
COPY manager/requirements.txt /tmp/manager-requirements.txt
COPY worker/requirements.txt /tmp/worker-requirements.txt
COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN pip install --no-cache-dir \
    -r /tmp/manager-requirements.txt \
    -r /tmp/worker-requirements.txt \
    -r /tmp/requirements-dev.txt

# Copy application source, tests, and tools
COPY manager/ /app/manager/
COPY worker/ /app/worker/
COPY tests/ /app/tests/
COPY tools/ /app/tools/
COPY pytest.ini /app/pytest.ini

ENV DJANGO_SETTINGS_MODULE=sethlans_manager.settings \
    SETHLANS_SECURITY_DEBUG=true \
    SETHLANS_SECURITY_SECRET_KEY=test-only-not-for-production \
    PYTHONPATH=/app/manager:/app/worker \
    DISPLAY=:99

RUN mkdir -p /results

# Start Xvfb before running tests
ENTRYPOINT ["sh", "-c", "Xvfb :99 -screen 0 1024x768x24 &>/dev/null & exec \"$@\"", "--"]
CMD ["pytest", "tests/e2e", "--junitxml=/results/e2e.xml", "--timeout=300"]
