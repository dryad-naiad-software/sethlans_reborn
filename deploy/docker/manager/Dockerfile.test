# NOTE: Requires deploy/docker/manager/Dockerfile.test.dockerignore to override
# the repo-root .dockerignore (which excludes tests/ from the build context).
FROM python:3.14-slim-bookworm

# TARGETARCH is populated by BuildKit/buildx (values: amd64, arm64).
# Selects the pre-fetched Caddy binary from .tmp/caddy/linux-<arch>/.
ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        procps \
        libdbus-1-3 \
        libegl1 \
        libfontconfig1 \
        libgl1 \
        libglib2.0-0 \
        libxcb-cursor0 \
        libxcb-icccm4 \
        libxcb-keysyms1 \
        libxcb-shape0 \
        libxkbcommon0 \
        libxkbcommon-x11-0 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install all Python deps (manager + worker + wizard + dev/test)
COPY manager/requirements.txt /tmp/manager-requirements.txt
COPY worker/requirements.txt /tmp/worker-requirements.txt
COPY wizard/requirements.txt /tmp/wizard-requirements.txt
COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN pip install --no-cache-dir \
    -r /tmp/manager-requirements.txt \
    -r /tmp/worker-requirements.txt \
    -r /tmp/wizard-requirements.txt \
    -r /tmp/requirements-dev.txt

# Install Playwright Chromium browser + system deps. Required by the Phase 2
# wizard frontend integration tests (tests/integration/frontend/test_phase2_*),
# which drive a real headless Chromium via pytest-playwright. Without this,
# every test errors with "Executable doesn't exist at .../chrome-headless-shell".
# `--with-deps` works because the base image is debian-bookworm (apt-based).
RUN python -m playwright install --with-deps chromium

# Pre-fetched by docker-test.yml (tools/fetch_caddy.py --multi-arch ...).
# Placed at the path shared.frozen_paths.get_caddy_binary() resolves to
# in source/dev mode (`${get_app_dir()}/.venv-build/caddy/caddy`), which
# is what shared.caddy_supervisor._find_caddy_binary() looks up.
COPY --chmod=0755 .tmp/caddy/linux-${TARGETARCH}/caddy /app/.venv-build/caddy/caddy

# Copy application source, tests, and tools
COPY manager/ /app/manager/
COPY worker/ /app/worker/
COPY wizard/ /app/wizard/
COPY shared/ /app/shared/
COPY launcher/ /app/launcher/
COPY tests/ /app/tests/
COPY tools/ /app/tools/
COPY packaging/ /app/packaging/
COPY pytest.ini /app/pytest.ini
COPY VERSION /app/VERSION

ENV DJANGO_SETTINGS_MODULE=sethlans_manager.settings \
    SETHLANS_SECURITY_DEBUG=true \
    SETHLANS_SECURITY_SECRET_KEY=test-only-not-for-production \
    PYTHONPATH=/app:/app/manager:/app/worker

RUN mkdir -p /results

CMD ["pytest", "tests/unit", "--junitxml=/results/unit.xml"]
