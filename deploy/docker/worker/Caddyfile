# Sethlans Reborn worker Caddyfile for Docker images.
#
# This file is COPY'd to /etc/caddy/Caddyfile in the three worker
# Dockerfiles (worker-cpu, worker-nvidia, worker-rocm). The worker
# agent detects SETHLANS_WORKER_CADDYFILE_PATH and skips its native
# template-and-write path, spawning Caddy against this static config
# instead. Caddy resolves the {$VAR} placeholders from its process
# environment at config-load time; the caddy_supervisor overlays the
# cert/key/port values onto Caddy's env when it spawns the child.
#
# Invariants mirrored from caddy_template.render_worker_caddyfile():
#   - admin off (Caddy admin API disabled)
#   - auto_https off (no port 80 bind, no ACME)
#   - HTTP/1.1 only upstream-side (h1 servers global)
#   - TLS floor pinned to tls1.2 on the public vhost
#   - /setup/* and /api/setup/* return 404 on the public vhost;
#     loopback vhost passes them through so the wizard is
#     loopback-only during the setup window
#   - reverse_proxy transport pinned to HTTP/1.1

{
    admin off
    auto_https off
    servers {
        protocols h1
    }
}

# Public TLS vhost (LAN-reachable). Clients connect here.
:{$SETHLANS_WORKER_CADDY_PUBLIC_TLS_PORT} {
    tls {$SETHLANS_WORKER_CERT_PATH} {$SETHLANS_WORKER_KEY_PATH} {
        protocols tls1.2 tls1.3
    }

    @setup_paths {
        path /setup /setup/* /api/setup /api/setup/*
    }
    respond @setup_paths 404

    reverse_proxy 127.0.0.1:{$SETHLANS_WORKER_WAITRESS_UPSTREAM_PORT} {
        transport http {
            versions 1.1
        }
    }
}

# Loopback plaintext vhost. Setup wizard origin during setup window.
http://127.0.0.1:{$SETHLANS_WORKER_CADDY_LOOPBACK_PORT} {
    reverse_proxy 127.0.0.1:{$SETHLANS_WORKER_WAITRESS_UPSTREAM_PORT} {
        transport http {
            versions 1.1
        }
    }
}
