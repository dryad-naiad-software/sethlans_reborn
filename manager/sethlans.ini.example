# sethlans.ini.example
#
# An example of the Sethlans settings file, sethlans.ini. Setup writes
# this file; to write it by hand, copy this file to 'sethlans.ini' and
# modify the values as needed.
#
# Where the file lives (first match wins):
#   1. SETHLANS_SETTINGS_FILE (absolute path of the file)
#   2. SETHLANS_SETTINGS_DIR/sethlans.ini
#   3. From source with SETHLANS_MANAGER_DATA_DIR set: <that folder>/sethlans.ini
#      (the Docker image: /data/sethlans.ini)
#   4. Installed: the per-user Sethlans folder
#      (%LOCALAPPDATA%\Sethlans\, ~/Library/Application Support/Sethlans/,
#      $XDG_DATA_HOME/sethlans/ or ~/.local/share/sethlans/)
#   5. From source: manager/sethlans.ini (this folder)
#
# Values are read without interpolation: a '%' is a plain character.
# Settings in this file will be overridden by environment variables if they are set.
# For example, setting the SETHLANS_MANAGER_PORT environment variable will take
# precedence over the 'port' value defined here.

# [setup]
# Written by setup; setup counts as finished only with all three keys.
# version = 1
# One of: manager, manager_worker, worker
# mode = manager_worker
# ISO 8601 UTC time setup finished.
# completed_at = 2025-01-01T00:00:00+00:00

[paths]
# Root of the data folder (absolute). The manager keeps its database,
# media, logs and static files in <data_dir>/manager, the worker its
# tools, assets and renders in <data_dir>/worker. This applies in every
# mode, source included. Each component's data folder is, first match
# wins: SETHLANS_MANAGER_DATA_DIR / SETHLANS_WORKER_DATA_DIR >
# SETHLANS_DATA_ROOT/<component> > data_dir/<component> > the default
# (<settings folder>/<component>; from source the manager's default stays
# this manager/ folder). Identity files (TLS keys, the secret key, the
# worker's config.json) never follow data_dir or SETHLANS_DATA_ROOT; they
# stay in the settings folder (from source: manager/), or in the
# component's *_DATA_DIR when that is set.
# data_dir = D:\SethlansData

[server]
# Bind address for the manager server.
# Default: 0.0.0.0 (all interfaces — accessible from network)
# Set to 127.0.0.1 to restrict to localhost only.
host = 0.0.0.0
# The port the manager server will run on.
port = 8080
# Loopback-only plaintext HTTP port for the tray helper's
# /api/status/public/ endpoint.  Bound to 127.0.0.1 only; never
# reachable from the network.  Override with the
# SETHLANS_MANAGER_LOOPBACK_PORT environment variable.
# Default: 8088
# loopback_port = 8088
#
# --- Caddy front-door ports (manager spec Phase 3) ---
# Caddy terminates TLS on ``public_port`` and exposes a loopback
# plaintext listener on ``caddy_loopback_port``. Both proxy to the
# underlying Waitress listeners. Override with
# SETHLANS_MANAGER_PUBLIC_PORT / SETHLANS_MANAGER_CADDY_LOOPBACK_PORT.
#
# Default: public_port = port (same 8080 TLS port workers connect to).
# public_port = 8080
# Default: caddy_loopback_port = 8089 (distinct from loopback_port
# which Waitress owns).
# caddy_loopback_port = 8089
#
# Path override for the launcher-templated Caddyfile. Defaults to
# ``<settings folder>/manager/caddy/Caddyfile``. When
# ``SETHLANS_MANAGER_CADDYFILE_PATH`` env var is set at launch time,
# the launcher skips templating and uses that path verbatim — this is
# how the Docker image ships a static Caddyfile.
# caddyfile_path =
#
# --- Waitress listener ports (manager spec Phase 5) ---
# Waitress now serves BOTH the public-origin and internal-origin
# Caddy vhosts. Both listeners bind 127.0.0.1 only; Caddy is the
# only TLS / network-reachable listener.
#
# Public-origin Waitress port. Caddy's public TLS vhost proxies
# here. Override with SETHLANS_MANAGER_WAITRESS_PORT_PUBLIC.
# Default: 8090 (range 8090-8099 during auto-allocation).
# waitress_loopback_port_public = 8090
# Internal-origin Waitress port. Caddy's loopback plaintext vhost
# proxies here; serves only /api/status/public/ (tray helper).
# Override with SETHLANS_MANAGER_WAITRESS_PORT_INTERNAL, or
# SETHLANS_MANAGER_LOOPBACK_PORT for legacy Phase-2 configs.
# Default: 8088 (matches the pre-Phase-5 loopback_port).
# waitress_loopback_port_internal = 8088
#
# --- Waitress tuning (manager spec Phase 5 "Waitress tuning") ---
# Spec-fixed defaults; overrides should be rare and documented.
# Override individual values with SETHLANS_MANAGER_WAITRESS_{KEY}.
#
# Thread-pool size. Sized to absorb N concurrent asset uploads
# without starving heartbeats at a target fleet of 20-30 workers.
# Default: 16
# waitress_threads = 16
# Max seconds a channel may stay idle between bytes before Waitress
# closes it. Raised above the Waitress default to tolerate slow-LAN
# asset uploads from distant workers.
# Default: 300
# waitress_channel_timeout = 300
# Max concurrent open connections. High enough to absorb brief
# heartbeat-polling bursts without tarpitting.
# Default: 1000
# waitress_connection_limit = 1000
# Max accepted request body size in bytes on the upload paths
# (.blend asset uploads, worker render output). Every other path is
# limited to 128 KiB regardless of this value (issue #260).
# Default: 10739515392 (10 GiB file + 2 MiB multipart headroom)
# waitress_max_request_body_size = 10739515392

[tls]
# Path to PEM-encoded certificate file.
# If not set, a self-signed cert is auto-generated at first run.
# cert_file =
# Path to PEM-encoded private key file.
# key_file =

[security]
# Django secret key — generate a unique value for production.
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# secret_key = your-unique-secret-key-here

# Set to False for production deployments.
# debug = False

# Comma-separated list of allowed hostnames.
# allowed_hosts = sethlans.example.com, 192.168.1.100

# NOTE: The worker enrollment key now lives in the ManagerSettings
# database row, NOT in this file.  Use `python manage.py show_enrollment_key`
# to display it, `python manage.py rotate_enrollment_key` to rotate it,
# or the admin UI ("regenerate enrollment key" button).  An
# `enrollment_key =` option here is ignored.
#
# The persisted secret key lives in its own file, secret_key, in the
# manager identity folder (<settings folder>/manager, or
# SETHLANS_MANAGER_DATA_DIR when set), not in this file; secret_key
# above is only an override.

[database]
# Database backend configuration.
# Default: SQLite (no configuration needed).
#
# Environment variables override these values:
#   SETHLANS_DB_ENGINE, SETHLANS_DB_NAME, SETHLANS_DB_HOST,
#   SETHLANS_DB_PORT, SETHLANS_DB_USER, SETHLANS_DB_PASSWORD
#   SETHLANS_DB_PASSWORD_FILE (Docker secrets — reads file contents)
#   SETHLANS_DATABASE_URL (composite URL, takes precedence over individual vars)
#
# --- SQLite (default) ---
# engine = sqlite
# name = /path/to/db.sqlite3
#
# --- PostgreSQL ---
# engine = postgresql
# name = sethlans
# host = localhost
# port = 5432
# user = sethlans
# password = your-password-here
#
# --- MySQL / MariaDB ---
# engine = mysql
# name = sethlans
# host = localhost
# port = 3306
# user = sethlans
# password = your-password-here
# (MySQL and MariaDB go through PyMySQL, pure Python, on every OS.)
#
# --- TLS to the database (external DBs only) ---
# tls: default false (env SETHLANS_DB_TLS). tls_ca_file is needed for
# MySQL/MariaDB, and for PostgreSQL verify-full / verify-ca. tls_mode is
# PostgreSQL only: verify-full (default), verify-ca or require.
# tls = true
# tls_ca_file = /path/to/ca.pem
# tls_mode = verify-full
#
# --- Persistent connections (external DBs only) ---
# Django CONN_MAX_AGE — how long (seconds) to reuse a pooled database
# connection across requests before closing and reopening it.  Larger
# values reduce per-request connection overhead on threaded Waitress
# (Phase 5); set to 0 to disable persistent connections entirely.
# Ignored for SQLite (each request opens a fresh connection).  Override
# via the SETHLANS_MANAGER_DB_CONN_MAX_AGE environment variable.
# Default: 60
# conn_max_age = 60

[enrollment]
# Friendly name broadcast via multicast discovery.  Truncated to 64
# characters.  Default: "Sethlans Manager"  (env: SETHLANS_ENROLLMENT_NAME)
# name = Studio A Render Farm

# Advertised IPv4 address for multicast discovery.  When unset, the
# manager auto-picks the first non-loopback IPv4 from an enumeration
# of NICs (skipping docker/VM virtual bridges).  Pin this on multi-NIC
# studio hosts that have both a studio LAN NIC and a private
# render-network NIC.  (env: SETHLANS_ENROLLMENT_ADVERTISED_IP)
# advertised_ip = 192.168.1.50

# [ffmpeg]
# Optional: path to a custom FFmpeg binary. When set, this overrides PATH
# detection and the bundled download. Useful for power users with custom
# builds (NVENC, VAAPI, or other exotic codecs) where a major version >= 8
# is required.
# path = /usr/local/bin/ffmpeg

# [first_admin]
# Written by setup and removed by the manager's first normal start,
# which creates this administrator. Never hand-write a plain password
# here; password_hash is a Django password hash.
# username = admin
# email = admin@example.com
# password_hash =
# replace_password = false

# [launcher]
# Reserved.
# start_at_login = false
