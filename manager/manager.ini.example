# manager.ini.example
#
# This is an example configuration file for the Sethlans Manager.
# To use it, copy this file to 'manager.ini' in the same directory
# and modify the values as needed.
#
# Settings in this file will be overridden by environment variables if they are set.
# For example, setting the SETHLANS_MANAGER_PORT environment variable will take
# precedence over the 'port' value defined here.

[server]
# Bind address for the manager server.
# Default: 0.0.0.0 (all interfaces — accessible from network)
# Set to 127.0.0.1 to restrict to localhost only.
host = 0.0.0.0
# The port the manager server will run on.
port = 8080
# Loopback-only plaintext HTTP port for the tray helper's
# /api/status/public/ endpoint.  Bound to 127.0.0.1 only; never
# reachable from the network.  Override with the
# SETHLANS_MANAGER_LOOPBACK_PORT environment variable.
# Default: 8088
# loopback_port = 8088
#
# --- Caddy front-door ports (manager spec Phase 3) ---
# Caddy terminates TLS on ``public_port`` and exposes a loopback
# plaintext listener on ``caddy_loopback_port``. Both proxy to the
# underlying uvicorn / Waitress listeners. Override with
# SETHLANS_MANAGER_PUBLIC_PORT / SETHLANS_MANAGER_CADDY_LOOPBACK_PORT.
#
# Default: public_port = port (same 8080 TLS port workers connect to).
# public_port = 8080
# Default: caddy_loopback_port = 8089 (distinct from loopback_port
# which Waitress owns).
# caddy_loopback_port = 8089
#
# Path override for the launcher-templated Caddyfile. Defaults to
# ``<manager_data_dir>/caddy/Caddyfile``. When
# ``SETHLANS_MANAGER_CADDYFILE_PATH`` env var is set at launch time,
# the launcher skips templating and uses that path verbatim — this is
# how the Docker image ships a static Caddyfile.
# caddyfile_path =

[tls]
# Path to PEM-encoded certificate file.
# If not set, a self-signed cert is auto-generated at first run.
# cert_file =
# Path to PEM-encoded private key file.
# key_file =

[security]
# Django secret key — generate a unique value for production.
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# secret_key = your-unique-secret-key-here

# Set to False for production deployments.
# debug = False

# Comma-separated list of allowed hostnames.
# allowed_hosts = sethlans.example.com, 192.168.1.100

# NOTE: The worker enrollment key now lives in the ManagerSettings
# database row, NOT in this file.  Use `python manage.py show_enrollment_key`
# to display it, `python manage.py rotate_enrollment_key` to rotate it,
# or the admin UI ("regenerate enrollment key" button).  The legacy
# `enrollment_key =` option is read ONCE during the 0017 migration as
# a compatibility shim and is ignored thereafter.

[database]
# Database backend configuration.
# Default: SQLite (no configuration needed).
#
# Environment variables override these values:
#   SETHLANS_DB_ENGINE, SETHLANS_DB_NAME, SETHLANS_DB_HOST,
#   SETHLANS_DB_PORT, SETHLANS_DB_USER, SETHLANS_DB_PASSWORD
#   SETHLANS_DB_PASSWORD_FILE (Docker secrets — reads file contents)
#   SETHLANS_DATABASE_URL (composite URL, takes precedence over individual vars)
#
# --- SQLite (default) ---
# engine = sqlite
# name = /path/to/db.sqlite3
#
# --- PostgreSQL ---
# engine = postgresql
# name = sethlans
# host = localhost
# port = 5432
# user = sethlans
# password = your-password-here
#
# --- MySQL / MariaDB ---
# engine = mysql
# name = sethlans
# host = localhost
# port = 3306
# user = sethlans
# password = your-password-here
#
# --- Persistent connections (external DBs only) ---
# Django CONN_MAX_AGE — how long (seconds) to reuse a pooled database
# connection across requests before closing and reopening it.  Larger
# values reduce per-request connection overhead on threaded Waitress
# (Phase 5); set to 0 to disable persistent connections entirely.
# Ignored for SQLite (each request opens a fresh connection).  Override
# via the SETHLANS_MANAGER_DB_CONN_MAX_AGE environment variable.
# Default: 60
# conn_max_age = 60

[enrollment]
# Friendly name broadcast via multicast discovery.  Truncated to 64
# characters.  Default: "Sethlans Manager"  (env: SETHLANS_ENROLLMENT_NAME)
# name = Studio A Render Farm

# Advertised IPv4 address for multicast discovery.  When unset, the
# manager auto-picks the first non-loopback IPv4 from an enumeration
# of NICs (skipping docker/VM virtual bridges).  Pin this on multi-NIC
# studio hosts that have both a studio LAN NIC and a private
# render-network NIC.  (env: SETHLANS_ENROLLMENT_ADVERTISED_IP)
# advertised_ip = 192.168.1.50