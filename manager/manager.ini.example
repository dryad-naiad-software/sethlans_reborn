# manager.ini.example
#
# This is an example configuration file for the Sethlans Manager.
# To use it, copy this file to 'manager.ini' in the same directory
# and modify the values as needed.
#
# Settings in this file will be overridden by environment variables if they are set.
# For example, setting the SETHLANS_MANAGER_PORT environment variable will take
# precedence over the 'port' value defined here.

[server]
# Bind address for the manager server.
# Default: 0.0.0.0 (all interfaces — accessible from network)
# Set to 127.0.0.1 to restrict to localhost only.
host = 0.0.0.0
# The port the manager server will run on.
port = 8080

[tls]
# Path to PEM-encoded certificate file.
# If not set, a self-signed cert is auto-generated at first run.
# cert_file =
# Path to PEM-encoded private key file.
# key_file =

[security]
# Django secret key — generate a unique value for production.
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# secret_key = your-unique-secret-key-here

# Set to False for production deployments.
# debug = False

# Comma-separated list of allowed hostnames.
# allowed_hosts = sethlans.example.com, 192.168.1.100

# NOTE: The worker enrollment key now lives in the ManagerSettings
# database row, NOT in this file.  Use `python manage.py show_enrollment_key`
# to display it, `python manage.py rotate_enrollment_key` to rotate it,
# or the admin UI ("regenerate enrollment key" button).  The legacy
# `enrollment_key =` option is read ONCE during the 0017 migration as
# a compatibility shim and is ignored thereafter.

[enrollment]
# Friendly name broadcast via multicast discovery.  Truncated to 64
# characters.  Default: "Sethlans Manager"  (env: SETHLANS_ENROLLMENT_NAME)
# name = Studio A Render Farm

# Advertised IPv4 address for multicast discovery.  When unset, the
# manager auto-picks the first non-loopback IPv4 from an enumeration
# of NICs (skipping docker/VM virtual bridges).  Pin this on multi-NIC
# studio hosts that have both a studio LAN NIC and a private
# render-network NIC.  (env: SETHLANS_ENROLLMENT_ADVERTISED_IP)
# advertised_ip = 192.168.1.50