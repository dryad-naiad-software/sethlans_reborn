# Sethlans Reborn — dev harness environment overrides.
#
# Copy this file to .env in the project root to apply local dev defaults
# without exporting variables in every shell. The actual .env is
# gitignored. Lines beginning with # are comments. KEY=value lines set
# os.environ ONLY when the variable is not already present (shell wins
# over .env).
#
# Variables consumed by tools/dev_*.py harness scripts only. Existing
# SETHLANS_* env vars the components themselves honour pass through
# unchanged — see CLAUDE.md and worker/config.ini.example for those.

# --- Dev harness paths -----------------------------------------------

# Relocate the dev data root. Default is <project_root>/temp/dev-data.
# Relative paths resolve against the project root.
# SETHLANS_DEV_DATA_ROOT=temp/dev-data

# Reuse existing dev TLS certs under <data-dir>/tls/. Default is 1
# (reuse). Set to 0 to force regeneration on each run.
# SETHLANS_DEV_TLS_REUSE=1

# Pass-through log level for spawned components (DEBUG/INFO/WARNING/...)
# SETHLANS_DEV_LOG_LEVEL=INFO

# --- Per-script port overrides ---------------------------------------

# tools/dev_wizard.py — pin the wizard port. Default is to scan
# 8099, 8101, 8102, 8103, 8104.
# SETHLANS_DEV_WIZARD_PORT=8101

# tools/dev_manager.py — pin the manager port. Default is to scan
# 8080..8099.
# SETHLANS_DEV_MANAGER_PORT=8080

# tools/dev_worker.py — pin the worker UI port. Default is to scan
# 8081..8089.
# SETHLANS_DEV_WORKER_UI_PORT=8081

# --- Pass-through SETHLANS_* (examples) ------------------------------
#
# These are honoured by the components directly; the harness scripts
# do not touch them. Listed here so devs know what's available.

# SETHLANS_MANAGER_HOST=0.0.0.0
# SETHLANS_MANAGER_PORT=8080
# SETHLANS_WIZARD_PORT=8101
# SETHLANS_TLS_CERT_FILE=/abs/path/to/cert.pem
# SETHLANS_TLS_KEY_FILE=/abs/path/to/key.pem
# SETHLANS_TRAY_IPC_SECRET=hex-secret-here
# SETHLANS_DATA_DIR=/abs/path/to/data
# SETHLANS_MANAGER_DATA_DIR=/abs/path/to/manager-data
# SETHLANS_WORKER_DATA_DIR=/abs/path/to/worker-data
