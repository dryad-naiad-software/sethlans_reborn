[manager]
# The hostname or IP address of the Sethlans Manager server.
host = 127.0.0.1
# The port the Manager server is running on.
port = 7075

# --- Authentication ---
# WARNING: Tokens and enrollment keys are transmitted over HTTP in cleartext.
# Use a wired network for security. HTTPS support is a future enhancement.
#
# Pre-shared enrollment key provided by the manager admin.
# Used for initial registration. Leave empty after enrollment completes.
enrollment_key =
# API token received after successful enrollment.
# This is written automatically by the worker -- do not edit manually.
# Set restrictive permissions on this file: chmod 600 config.ini
# On Windows, restrict access via file Properties > Security tab.
api_token =

[worker]
# How often (in seconds) the worker sends a heartbeat to the manager.
heartbeat_interval = 30
# How often (in seconds) the worker polls for new jobs.
polling_interval = 5
# Number of CPU threads to use for rendering. 0 = Blender default (all).
cpu_threads = 0

# --- Worker Web UI ---
# Enable or disable the embedded web dashboard.
ui_enabled = true
# Port for the web UI HTTP server.
ui_port = 7076
# Bind address for the web UI.
# Default: 0.0.0.0 (all interfaces - accessible from network).
# Set to 127.0.0.1 to restrict to localhost only.
# NOTE: Control endpoints require password authentication.
# Change the default password via the dashboard on first use.
ui_bind_address = 0.0.0.0
# Password hash and salt for control endpoint authentication.
# These are written automatically when you set a password at first startup.
# Do NOT edit these manually. To reset, delete both lines and restart.
ui_password_hash =
ui_password_salt =
