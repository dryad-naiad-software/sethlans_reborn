# DEPRECATED: config.ini is still read for backward compatibility but
# all writes go to the new JSON config at per-OS paths:
#   Windows: %LOCALAPPDATA%\Sethlans\worker\config.json
#   macOS:   ~/Library/Application Support/Sethlans/worker/config.json
#   Linux:   $XDG_DATA_HOME/sethlans/worker/config.json
#            (fallback ~/.local/share/sethlans/worker/config.json)
# New installs should leave this file absent. The first-run enrollment
# wizard populates the JSON config automatically.

[manager]
# The hostname or IP address of the Sethlans Manager server.
# Use the manager's real network IP, not 127.0.0.1, so the
# dashboard link works and remote workers can connect.
host = 127.0.0.1
# The port the Manager server is running on.
port = 8080

# --- Authentication ---
# api_token, cert_fingerprint, and manager_id live in the JSON config
# store now — they are NOT env-var overridable (FR-28 exception list).
# The first-run enrollment wizard writes them to the JSON file with
# 0o600 permissions (POSIX) or restricted ACL (Windows).
api_token =
cert_fingerprint =
manager_id =

[worker]
# How often (in seconds) the worker sends a heartbeat to the manager.
heartbeat_interval = 30
# How often (in seconds) the worker polls for new jobs.
polling_interval = 5
# Number of CPU threads for rendering. 0 = auto (cores - 1).
# The effective thread count is capped at (cores - 1); any user value
# at or above the ceiling is silently capped, leaving one core of
# scheduler headroom for the OS, the worker agent, and any co-running
# GPU job's host process. Override via SETHLANS_WORKER_CPU_THREADS.
cpu_threads = 0

# --- Compute method and graphics cards ---
# Not read from this file. CPU or GPU, the GPU mode and the ticked graphics
# cards are the "compute" section of the JSON config, set in the worker's
# setup wizard and settings page. A new worker renders on the CPU only until
# a person ticks a card. To set them for a whole process instead (CI, Docker),
# use these environment variables; while any of the first three is set, the
# worker pages cannot change the choice:
#   SETHLANS_COMPUTE_METHOD = cpu | gpu | cpu_gpu        (default cpu)
#   SETHLANS_COMPUTE_GPU_MODE = split | combined         (default split)
#       split    - one GPU slot per ticked card.
#       combined - one slot; one Blender render uses every ticked card. Only
#                  for two or more cards Blender drives the same way
#                  (CUDA/OptiX, HIP, oneAPI or Metal).
#   SETHLANS_COMPUTE_CARDS = comma-separated PCI addresses of the ticked
#       cards, for example 0000:01:00.0,0000:23:00.0 (apple-gpu on macOS).
#       The worker log lists every card with its address at start.
#   SETHLANS_COMPUTE_ALLOW_MANAGER_CHANGES = true | false (default true)

# --- Worker Web UI ---
# Enable or disable the embedded web dashboard.
ui_enabled = true
# Port for the web UI HTTP server.
ui_port = 8081
# Bind address for the web UI.
# Default: 0.0.0.0 (all interfaces - accessible from network).
# Set to 127.0.0.1 to restrict to localhost only.
# NOTE: Control endpoints require password authentication.
# Change the default password via the dashboard on first use.
ui_bind_address = 0.0.0.0
# Password hash and salt for control endpoint authentication.
# These are written automatically when you set a password at first startup.
# Do NOT edit these manually. To reset, delete both lines and restart.
ui_password_hash =
ui_password_salt =

[worker_tls]
# BYO certificate for the worker web UI.
# Both cert_file and key_file must be set for a custom certificate.
# If unset, a self-signed certificate is auto-generated on first run.
# Override via SETHLANS_WORKER_TLS_CERT_FILE / SETHLANS_WORKER_TLS_KEY_FILE env vars.
cert_file =
key_file =

[idle_detection]
# Enable idle detection. Set to false to disable (always claim jobs).
# Automatically false on headless/Docker hosts.
# enabled = true
# Seconds of keyboard/mouse inactivity before the machine is considered idle.
# idle_threshold_seconds = 900
# GPU utilization threshold (percent). If any GPU is above this, do not claim.
# gpu_utilization_threshold = 20
# CPU utilization threshold (percent). Rolling 3-sample average.
# cpu_utilization_threshold = 70
# Seconds of sustained input activity (while rendering) before yield fires.
# slow_path_threshold_seconds = 90
# Maximum seconds to wait for a render to finish after yield triggers.
# grace_period_cap_seconds = 120
# Creative app names for yield detection (comma-separated).
# Only [a-zA-Z0-9._-] characters allowed per entry.
# creative_app_names = blender,maya,houdini,nuke,premiere,afterfx,resolve,cinema4d,modo

[scheduling]
# Claim window: restrict job claiming to specific time windows.
# enabled = false
# Days of the week (comma-separated, 3-letter lowercase abbreviations).
# days = mon,tue,wed,thu,fri
# Start time (HH:MM, 24-hour format). Cross-midnight supported.
# start = 18:00
# End time (HH:MM, 24-hour format).
# end = 07:00
# Timezone: "local" for system local, or IANA name (e.g., America/Los_Angeles).
# timezone = local
# When true and inside the window, skip idle detection checks.
# overrides_idle_detection = false

[unreal]
# Unreal Engine 5.8 still rendering (phase 1, Windows only). Env vars:
# SETHLANS_UNREAL_<KEY>. Changing a value needs a worker restart.
# enabled = false
# The Sethlans share root, a UNC directory (\\host\share[\dir]). Use a
# DNS-resolvable fully qualified host name; the share should be writable by
# farm admins only (its content is pinned by SHA-256, but anyone who can
# write it before the admin fingerprints a file can run code on workers).
# share =
# Local cache for project archives, working copies, the farm-private Zen
# DDC and the farm profile. A local NTFS path without spaces, ',' or ';'.
# Default: <worker data dir>\unreal
# cache_dir =
# The farm-private zenserver's port (never 8558, an artist editor's port).
# zen_port = 8668
# Behavior change (per-user isolation): every farm Unreal launch runs with
# USERPROFILE, LOCALAPPDATA, APPDATA, HOMEDRIVE/HOMEPATH and TEMP/TMP pointed
# at <cache_dir>\ueprofile, like Blender's --factory-startup. An artist's
# engine-wide User*.ini overrides, Editor Preferences and UBT's
# BuildConfiguration.xml therefore do not apply to farm renders, and farm
# renders never write the artist's Unreal settings. If Windows shell folders
# are redirected (for example Documents in OneDrive), Unreal work is refused
# on that machine; use a dedicated render account.
# keep_job_logs = 10
# warmup_hold_seconds = 240
# render_timeout_seconds = 14400

[gpu_memory]
# How the worker reads graphics card memory (used by Unreal rendering).
# Env var: SETHLANS_GPU_MEMORY_SOURCE. Changing it needs a worker restart.
# auto (default) picks the platform's source; nvidia-smi pins that source
# (on Windows only the copy the driver installs in System32 is run); none
# reads nothing (Unreal then needs SETHLANS_UNREAL_VRAM_MB).
# source = auto
