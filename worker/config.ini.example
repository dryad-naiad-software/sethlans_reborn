# DEPRECATED: config.ini is still read for backward compatibility but
# all writes go to the new JSON config at per-OS paths:
#   Windows: %LOCALAPPDATA%\Sethlans\worker\config.json
#   macOS:   ~/Library/Application Support/Sethlans/worker/config.json
#   Linux:   $XDG_DATA_HOME/sethlans/worker/config.json
#            (fallback ~/.local/share/sethlans/worker/config.json)
# New installs should leave this file absent. The first-run enrollment
# wizard populates the JSON config automatically.

[manager]
# The hostname or IP address of the Sethlans Manager server.
# Use the manager's real network IP, not 127.0.0.1, so the
# dashboard link works and remote workers can connect.
host = 127.0.0.1
# The port the Manager server is running on.
port = 8080

# --- Authentication ---
# api_token, cert_fingerprint, and manager_id live in the JSON config
# store now — they are NOT env-var overridable (FR-28 exception list).
# The first-run enrollment wizard writes them to the JSON file with
# 0o600 permissions (POSIX) or restricted ACL (Windows).
api_token =
cert_fingerprint =
manager_id =

[worker]
# How often (in seconds) the worker sends a heartbeat to the manager.
heartbeat_interval = 30
# How often (in seconds) the worker polls for new jobs.
polling_interval = 5
# Number of CPU threads for rendering. 0 = auto (cores - 1).
# The effective thread count is capped at (cores - 1); any user value
# at or above the ceiling is silently capped, leaving one core of
# scheduler headroom for the OS, the worker agent, and any co-running
# GPU job's host process. Override via SETHLANS_WORKER_CPU_THREADS.
cpu_threads = 0
# GPU capacity mode. One of:
#   split    - (default) N physical GPUs become N parallel GPU slots.
#   combined - N physical GPUs become 1 slot; one Blender invocation
#              uses every non-CPU device. Trades throughput for
#              per-frame speed. Incompatible with SETHLANS_FORCE_GPU_INDEX.
# Override via SETHLANS_GPU_MODE environment variable.
gpu_mode = split

# --- Worker Web UI ---
# Enable or disable the embedded web dashboard.
ui_enabled = true
# Port for the web UI HTTP server.
ui_port = 8081
# Bind address for the web UI.
# Default: 0.0.0.0 (all interfaces - accessible from network).
# Set to 127.0.0.1 to restrict to localhost only.
# NOTE: Control endpoints require password authentication.
# Change the default password via the dashboard on first use.
ui_bind_address = 0.0.0.0
# Password hash and salt for control endpoint authentication.
# These are written automatically when you set a password at first startup.
# Do NOT edit these manually. To reset, delete both lines and restart.
ui_password_hash =
ui_password_salt =
