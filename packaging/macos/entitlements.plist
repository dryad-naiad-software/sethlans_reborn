<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for hardened runtime notarization.

  These entitlements are required for Apple notarization when signing
  with codesign - -options runtime. PyInstaller bundles need the
  JIT and unsigned executable memory entitlements because Python's
  ctypes and cffi use dynamic code generation.
-->
<plist version="1.0">
<dict>
    <!-- Allow JIT compilation (required by Python's ctypes/cffi) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required by PyInstaller) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading user-installed dylibs (Blender, etc.) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network access for manager HTTPS server and worker API calls -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File access for render output, assets, Blender binaries -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
